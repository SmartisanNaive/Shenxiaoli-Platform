# Local HTTP entry point; HTTPS is provided by your tunnel service.
# No public domain or URL is required. Forward the tunnel to 127.0.0.1:8080.
WEB_PORT=8080

# Exact address allowed to sign in as admin after email OTP verification.
ADMIN_EMAIL=jianghanchn@vip.qq.com

# Generate a fresh secret with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Resend must use an authenticated sender domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM=noreply@kangtaoai.cn

# Optional: signed delivery webhooks. Leave blank if not using receipts.
RESEND_WEBHOOK_SECRET=

# Optional overrides for deployments with a fixed URL or separate frontend.
# BETTER_AUTH_URL=https://your-public-address
# ALLOWED_ORIGINS=https://your-public-address
