    "frontend"
  ],
  "license": "MIT",
  "homepage": "https://github.com/shenxiaoli/shenxiaoli-platform#readme",
  "bugs": {
    "url": "https://github.com/shenxiaoli/shenxiaoli-platform/issues"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
