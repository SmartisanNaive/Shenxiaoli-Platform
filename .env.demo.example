# Non-production demo/staging configuration.
# Copy to .env and replace every example value before starting the stack.
# Never commit the populated .env file.

# Public demo hostname. Point its DNS A/AAAA records at the demo server first.
SITE_ADDRESS=demo.example.edu
BETTER_AUTH_URL=https://demo.example.edu
ALLOWED_ORIGINS=https://demo.example.edu

# Generate a unique value with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Resend: use a sending domain whose DNS you control and have authenticated.
# Configure the webhook URL as https://demo.example.edu/api/webhooks/resend.
RESEND_API_KEY=re_replace_me
RESEND_FROM="Shenxiaoli Demo <noreply@mail.example.edu>"
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Optional host-side encrypted backup settings for ops/backup.sh and
# ops/restore.sh. Keep the Restic password in a separate protected file;
# provide cloud credentials through the host's secret manager or IAM role.
# Load .env into the shell before invoking either script:
# set -a; . ./.env; set +a
RESTIC_REPOSITORY=s3:https://backup.example.net/shenxiaoli-demo
RESTIC_PASSWORD_FILE=/etc/shenxiaoli/restic-password

# Admins are granted after registering and verifying their campus email:
# docker compose exec api bun run src/admin.ts grant-admin name@suat-sz.edu.cn
# Course CSV files are uploaded and reviewed in the authenticated admin UI.
