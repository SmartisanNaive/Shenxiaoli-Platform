{
  "name": "@shenxiaoli/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono + SQLite API for 深小狸",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "bun test",
    "admin:grant": "bun run src/admin.ts grant-admin",
    "db:migrate": "bun run src/migrate.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "hono": "^4.7.2",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
