# Development-only account flow. Never enable this in production.
DEMO_AUTH_ENABLED=true

# Use a long, random value in production; sessions and rate-limit subjects
# are protected with this secret. Do not commit real secrets.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to write to this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional paths; defaults are backend/data and backend/uploads.
DATABASE_PATH=./data/shenxiaoli.sqlite
UPLOADS_PATH=./uploads

PORT=8787
