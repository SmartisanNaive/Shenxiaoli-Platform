{
	auto_https off
}

:80 {
	encode zstd gzip
	root * /srv

	@api path /api /api/*
	handle @api {
		header Cache-Control "private, no-store"
		reverse_proxy api:8787 {
			header_up Host {http.request.hostport}
		}
	}

	handle /uploads/* {
		header Cache-Control "private, no-store"
		reverse_proxy api:8787 {
			header_up Host {http.request.hostport}
		}
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
